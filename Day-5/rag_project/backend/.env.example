# ==========================================
# Groq API Configuration (Fast LLM Inference)
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=auto  # Options: auto, groq, openai

# ==========================================
# OpenAI API Configuration (Optional / Fallback)
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here

# LLM Generation Parameters
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Embedding Configuration
EMBEDDING_PROVIDER=auto  # Options: auto, huggingface, openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Storage Configuration
STORAGE_DIR=./data/storage
DOCUMENTS_DIR=./data/documents

# Retrieval Configuration
SIMILARITY_TOP_K=10
RERANK_TOP_K=5

# Graph Configuration
GRAPH_STORE_TYPE=memory  # Options: memory, neo4j, falkordb
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
